[Unit]
Description=1984 server: Dossier's routes, sockets and loops
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=root
WorkingDirectory=/root/1984
ExecStart=/root/1984/venv/bin/python -m server.main
Environment=DB_POOL_SIZE=6
Environment=DB_POOL_OVERFLOW=10
Environment=OSU_REQUEST_GAP=0.3
Restart=always
RestartSec=2
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
